.operational-trace-module {
    --operational-alarm-slot-count: 1;
    --operational-trace-point-x: 50%;
    --operational-trace-line-x: 50%;
    --operational-trace-line-start: 50%;
    --operational-trace-line-end: 50%;
    --operational-trace-preview-delay: 0ms;
    --operational-trace-preview-duration: 1ms;
    --operational-trace-preview-marker-delay: 0ms;
    --operational-trace-preview-reveal-duration: 4000ms;
    --operational-trace-preview-hold-duration: 20000ms;
    --operational-trace-preview-fade-duration: 3000ms;
    --operational-trace-baseline-color: #e1e1e1;
    --operational-trace-line-neutral: #dddddd;
    --operational-trace-line-muted: #b8b8b8;
    --operational-trace-point-size: 16px;
    --operational-trace-chevron-size: 9px;
    --operational-trace-contract-chevron-size: 6px;
    --operational-trace-chevron-stroke: .05rem;
    --operational-trace-critical: #dc3545;
    --operational-trace-warning: #e0a800;
    --operational-trace-neutral: #6b6b6b;
    --operational-trace-route-y: 28%;
    --operational-trace-baseline-y: 74%;

    position: relative;
    width: 100%;
    min-width: 0;
}

.operational-alarm-board {
    display: grid;
    grid-template-columns: repeat(var(--operational-alarm-slot-count), minmax(0, 1fr));
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    align-items: stretch;
}

.operational-alarm-card {
    display: flex;
    align-items: center;
    gap: .3rem;
    min-width: 0;
    margin-inline: .16rem;
    padding: .35rem .4rem;
    border: 1px solid #bdbdbd;
    border-inline-start: 3px solid var(--operational-trace-neutral);
    border-radius: .4rem;
    background: #f2f2f2;
    color: #4d4d4d;
    cursor: pointer;
    user-select: none;
}

.operational-alarm-card--critical {
    border-inline-start-color: var(--operational-trace-critical);
}

.operational-alarm-card--warning {
    border-inline-start-color: var(--operational-trace-warning);
}

.operational-alarm-card__selector[data-selected='true'] {
    border-radius: .25rem;
    box-shadow: inset 0 0 0 1px currentColor;
}

.operational-alarm-card[data-rotation-active='false'] {
    display: none;
}

.operational-alarm-card__selector {
    display: flex;
    align-items: center;
    gap: .45rem;
    flex: 1 1 auto;
    min-width: 0;
    padding: .1rem;
}

.operational-alarm-card__criticality {
    flex: 0 0 auto;
    padding: .15rem .3rem;
    border-radius: .25rem;
    background: #ffffff;
    font-size: .65rem;
    font-weight: 700;
}

.operational-alarm-card__title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: .75rem;
    font-weight: 700;
}

.operational-alarm-card__time {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: .65rem;
}

.operational-alarm-card__action {
    flex: 0 0 auto;
    padding: .2rem .55rem;
    border: 1px solid #4d4d4d;
    border-radius: .35rem;
    background: transparent;
    color: #2b2b2b;
    font-size: .68rem;
    font-weight: 700;
}

.operational-alarm-board__rotator {
    position: relative;
    min-width: 0;
}

.operational-alarm-board__rotator .operational-alarm-card {
    width: calc(100% - .32rem);
    height: 100%;
}

.operational-alarm-board__rotator::after {
    content: attr(data-rotation-count);
    position: absolute;
    inset-block-start: -.3rem;
    inset-inline-end: -.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: #4d4d4d;
    color: #ffffff;
    font-size: .55rem;
    font-weight: 700;
}

.operational-trace {
    position: relative;
    width: 100%;
    height: 2rem;
    min-width: 0;
    overflow: hidden;
}

.operational-trace__alarm-layer,
.operational-trace__points {
    position: absolute;
    inset: 0;
}

.operational-trace__baseline {
    position: absolute;
    inset-inline: 0;
    inset-block-start: var(--operational-trace-baseline-y);
    height: 3px;
    transform: translateY(-50%);
    background: var(--operational-trace-baseline-color);
    opacity: .9;
}

.operational-trace__point {
    position: absolute;
    inset-inline-start: var(--operational-trace-point-x);
    inset-block-start: var(--operational-trace-baseline-y);
    width: var(--operational-trace-point-size);
    height: var(--operational-trace-point-size);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    z-index: 5;
}

.operational-trace__point-core {
    position: absolute;
    inset: 0;
    border: 2px solid var(--operational-trace-baseline-color);
    border-radius: 50%;
    background: #5b5c64;
}

.operational-trace__route {
    --operational-trace-route-color: var(--operational-trace-line-neutral);
    position: absolute;
    inset: 0;
    color: var(--operational-trace-route-color);
    opacity: 1;
    z-index: 1;
    transition:
        color .12s ease,
        opacity var(--operational-trace-preview-fade-duration) ease;
}

.operational-trace__route--critical {
    --operational-trace-route-active-color: var(--operational-trace-critical);
}

.operational-trace__route--warning {
    --operational-trace-route-active-color: var(--operational-trace-warning);
}

.operational-trace__route--neutral {
    --operational-trace-route-active-color: var(--operational-trace-neutral);
}

.operational-trace[data-has-selection='true'] .operational-trace__route[data-selected='false'] {
    --operational-trace-route-color: var(--operational-trace-line-muted);
    opacity: 1;
}

.operational-trace__route[data-previewing='true'] {
    --operational-trace-route-color: var(--operational-trace-route-active-color);
    opacity: 1;
    z-index: 3;
}

.operational-trace__route[data-previewing='true'][data-preview-phase='fade'] {
    opacity: 0;
}

.operational-trace__route[data-selected='true'] {
    --operational-trace-route-color: var(--operational-trace-route-active-color);
    opacity: 1;
    z-index: 4;
}

.operational-trace__route-card-connector,
.operational-trace__route-process-connector,
.operational-trace__route-local-connector,
.operational-trace__route-trunk {
    position: absolute;
    display: block;
    background: currentColor;
}

.operational-trace__route-card-connector {
    inset-inline-start: var(--operational-trace-line-x);
    inset-block-start: 0;
    width: 2px;
    height: var(--operational-trace-route-y);
    transform: translateX(-50%);
    transform-origin: top center;
}

.operational-trace__route-trunk {
    inset-inline-start: var(--operational-trace-line-start);
    inset-block-start: var(--operational-trace-route-y);
    width: calc(var(--operational-trace-line-end) - var(--operational-trace-line-start));
    height: 2px;
    transform: translateY(-50%);
}

.operational-trace__route--preview-forward .operational-trace__route-trunk {
    transform-origin: left center;
}

.operational-trace__route--preview-reverse .operational-trace__route-trunk {
    transform-origin: right center;
}

.operational-trace__route-process-connector {
    inset-inline-start: var(--operational-trace-line-x);
    inset-block-start: var(--operational-trace-route-y);
    width: 2px;
    height: calc(var(--operational-trace-baseline-y) - var(--operational-trace-route-y));
    transform: translateX(-50%);
    transform-origin: top center;
}

.operational-trace__route-local-connector {
    inset-inline-start: var(--operational-trace-line-x);
    inset-block-start: 0;
    width: 2px;
    height: var(--operational-trace-baseline-y);
    transform: translateX(-50%);
    transform-origin: top center;
}

.operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
.operational-trace__route-card-connector,
.operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
.operational-trace__route-process-connector {
    animation: operational-trace-preview-vertical var(--operational-trace-preview-duration) ease forwards;
    animation-delay: var(--operational-trace-preview-delay);
    animation-fill-mode: both;
}

.operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
.operational-trace__route-local-connector {
    animation: operational-trace-preview-local var(--operational-trace-preview-duration) ease forwards;
    animation-delay: var(--operational-trace-preview-delay);
    animation-fill-mode: both;
}

.operational-trace__route--preview-forward[data-previewing='true'][data-preview-phase='reveal']
.operational-trace__route-trunk {
    animation: operational-trace-preview-horizontal-forward var(--operational-trace-preview-duration) ease forwards;
    animation-delay: var(--operational-trace-preview-delay);
    animation-fill-mode: both;
}

.operational-trace__route--preview-reverse[data-previewing='true'][data-preview-phase='reveal']
.operational-trace__route-trunk {
    animation: operational-trace-preview-horizontal-reverse var(--operational-trace-preview-duration) ease forwards;
    animation-delay: var(--operational-trace-preview-delay);
    animation-fill-mode: both;
}

.operational-trace__route[data-selected='true']
.operational-trace__route-card-connector,
.operational-trace__route[data-selected='true']
.operational-trace__route-process-connector,
.operational-trace__route[data-selected='true']
.operational-trace__route-local-connector,
.operational-trace__route[data-selected='true']
.operational-trace__route-trunk {
    animation: none;
}

.operational-trace__marker {
    --operational-trace-marker-color: var(--operational-trace-neutral);
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    border: 1px solid var(--operational-trace-baseline-color);
    border-radius: 50%;
    background: var(--operational-trace-marker-color);
    color: #ffffff;
    line-height: 1;
    opacity: 1;
    z-index: 6;
    transition: opacity var(--operational-trace-preview-fade-duration) ease;
}

.operational-trace__marker--critical {
    --operational-trace-marker-color: var(--operational-trace-critical);
}

.operational-trace__marker--warning {
    --operational-trace-marker-color: var(--operational-trace-warning);
}

.operational-trace__marker[data-previewing='true'],
.operational-trace__marker[data-selected='true'] {
    display: grid;
}

.operational-trace__marker[data-previewing='true'][data-preview-phase='reveal'] {
    animation: operational-trace-preview-marker 220ms ease forwards;
    animation-delay: var(--operational-trace-preview-marker-delay);
    animation-fill-mode: both;
}

.operational-trace__marker[data-previewing='true'][data-preview-phase='fade'] {
    opacity: 0;
}

.operational-trace__marker[data-selected='true'] {
    animation: none;
    opacity: 1;
}

.operational-trace__marker-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
}

.operational-trace__marker-icon .bi {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: var(--operational-trace-chevron-size);
    line-height: 1;
    text-align: center;
    -webkit-text-stroke: var(--operational-trace-chevron-stroke) currentColor;
}

.operational-trace__marker-icon .bi::before {
    display: block;
    margin: 0;
    line-height: 1;
}

.operational-trace__marker--contract .operational-trace__marker-icon {
    inset-inline: 0;
    height: 50%;
}

.operational-trace__marker--contract .operational-trace__marker-icon--up {
    inset-block-start: 0;
    inset-block-end: auto;
}

.operational-trace__marker--contract .operational-trace__marker-icon--down {
    inset-block-start: auto;
    inset-block-end: 0;
}

.operational-trace__marker--contract .bi {
    font-size: var(--operational-trace-contract-chevron-size);
}

@keyframes operational-trace-preview-vertical {
    from {
        transform: translateX(-50%) scaleY(0);
    }
    to {
        transform: translateX(-50%) scaleY(1);
    }
}

@keyframes operational-trace-preview-local {
    from {
        transform: translateX(-50%) scaleY(0);
    }
    to {
        transform: translateX(-50%) scaleY(1);
    }
}

@keyframes operational-trace-preview-horizontal-forward {
    from {
        transform: translateY(-50%) scaleX(0);
    }
    to {
        transform: translateY(-50%) scaleX(1);
    }
}

@keyframes operational-trace-preview-horizontal-reverse {
    from {
        transform: translateY(-50%) scaleX(0);
    }
    to {
        transform: translateY(-50%) scaleX(1);
    }
}

@keyframes operational-trace-preview-marker {
    from {
        opacity: 0;
        transform: scale(.55);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

@media (prefers-reduced-motion: reduce) {
    .operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
    .operational-trace__route-card-connector,
    .operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
    .operational-trace__route-process-connector,
    .operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
    .operational-trace__route-local-connector,
    .operational-trace__route[data-previewing='true'][data-preview-phase='reveal']
    .operational-trace__route-trunk,
    .operational-trace__marker[data-previewing='true'][data-preview-phase='reveal'] {
        animation-duration: 1ms;
        animation-delay: 0ms;
    }
}

@media only screen and (min-width: 350px) {}
@media only screen and (min-width: 480px) {}
@media only screen and (min-width: 1280px) {}
@media only screen and (min-width: 1366px) {}
@media only screen and (min-width: 1536px) {}
@media only screen and (min-width: 1920px) {}
@media only screen and (min-width: 2560px) {
    .operational-trace-module {
        --operational-trace-point-size: 25px;
        --operational-trace-chevron-size: 14px;
        --operational-trace-contract-chevron-size: 10px;
    }

    .operational-trace {
        height: 2.9rem;
    }
    .operational-trace__route-trunk {
        height: 5px;
    }
    .operational-trace__route-local-connector,
    .operational-trace__route-card-connector,
    .operational-trace__route-process-connector {
        width: 5px;
    }

    .operational-trace__baseline {
        height: 6px;
    }
}